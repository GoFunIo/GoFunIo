{{#> layout subject="Potwierdź swój adres e-mail w AutoKeep"}}
  {{#*inline "preheader"}}Potwierdź swój adres e-mail, żeby aktywować konto w AutoKeep. Link jest ważny przez 24 godziny.{{/inline}}
  {{#*inline "footer"}}AutoKeep &middot; Ta wiadomość dotyczy Twojego konta i nie można jej wyłączyć w ustawieniach.{{/inline}}

  {{> icon-badge icon="mail" }}
  {{> greeting }}
  {{#> body-text }}witaj w AutoKeep! Potwierdź swój adres e-mail, żeby aktywować konto.{{/body-text}}
  {{> button label="Potwierdź e-mail" buttonWidth="150" }}
  {{#> body-text pb="24" }}Link jest ważny przez 24 godziny. Jeśli nie zakładałeś konta w
  AutoKeep, możesz zignorować tę wiadomość.{{/body-text}}
  {{> copy-link }}
{{/layout}}
