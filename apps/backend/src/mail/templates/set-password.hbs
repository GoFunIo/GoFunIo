{{#> layout subject="Ustaw hasło do AutoKeep"}}
  {{#*inline "preheader"}}Ustaw hasło do swojego konta AutoKeep. Link jest ważny przez {{ttlHours}} godziny.{{/inline}}
  {{#*inline "footer"}}AutoKeep &middot; Ta wiadomość dotyczy bezpieczeństwa Twojego konta i nie można jej wyłączyć w ustawieniach.{{/inline}}

  {{> icon-badge icon="lock" }}
  {{> greeting }}
  {{#> body-text }}ustaw hasło do swojego konta AutoKeep, żeby móc logować się adresem e-mail.{{/body-text}}
  {{> button label="Ustaw hasło" buttonWidth="200" }}
  {{#> body-text pb="24" }}Link jest ważny przez {{ttlHours}} godziny. Jeśli nie spodziewałeś się
  tej wiadomości, możesz ją zignorować.{{/body-text}}
  {{> copy-link }}
{{/layout}}
