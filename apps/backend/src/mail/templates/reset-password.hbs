{{#> layout subject="Zresetuj hasło do AutoKeep"}}
  {{#*inline "preheader"}}Kliknij link, aby ustawić nowe hasło do konta AutoKeep. Link jest ważny przez {{ttlHours}} godziny.{{/inline}}
  {{#*inline "footer"}}AutoKeep &middot; Ta wiadomość dotyczy bezpieczeństwa Twojego konta i nie można jej wyłączyć w ustawieniach.{{/inline}}

  {{> icon-badge icon="lock" }}
  {{> greeting }}
  {{#> body-text }}otrzymaliśmy prośbę o zresetowanie hasła do Twojego konta AutoKeep.{{/body-text}}
  {{> button label="Ustaw nowe hasło" buttonWidth="200" }}
  {{#> body-text pb="4" }}Link jest ważny przez {{ttlHours}} godziny.{{/body-text}}
  {{#> body-text pb="24" }}Jeśli to nie Ty prosiłeś o reset hasła, zignoruj tę wiadomość — Twoje
  obecne hasło pozostaje bez zmian.{{/body-text}}
  {{> copy-link }}
{{/layout}}
