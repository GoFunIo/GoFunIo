  {{> icon-badge icon="key-round" }}
  {{> greeting }}
  {{#> body-text pb="24" }}otrzymałeś dostęp do pojazdu
  <strong style="color: #111518">{{make}} {{model}} ({{registrationNumber}})</strong>.{{/body-text}}
