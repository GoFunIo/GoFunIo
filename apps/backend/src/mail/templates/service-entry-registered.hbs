{{!--
  UNWIRED template. No NotificationType / sender emits this yet — see templates/UNWIRED.md.
  Expected context: firstName?, make, model, registrationNumber, serviceType, serviceDate,
  cost, provider, link, assetBaseUrl, notificationSettingsUrl
  - serviceType: PL label per constants/serviceOptions.ts (FULL -> "Pełny serwis", ...)
  - cost: formatted amount without currency (template appends " zł")
  - provider: fall back to "—" when empty
--}}
{{#> layout subject="Zarejestrowano wpis serwisowy w AutoKeep"}}
  {{#*inline "preheader"}}Zarejestrowano nowy wpis w historii serwisowej pojazdu {{registrationNumber}}.{{/inline}}
  {{#*inline "footer"}}Otrzymujesz tę wiadomość, bo masz włączone powiadomienia e-mail dla kategorii Serwis, przeglądy i ubezpieczenia.<br /><a href="{{notificationSettingsUrl}}" target="_blank" style="color: #145ae2;">Zarządzaj powiadomieniami</a>{{/inline}}

  {{> icon-badge icon="wrench" }}
  {{> greeting }}
  {{#> body-text }}zarejestrowano nowy wpis w historii serwisowej pojazdu
  <strong style="color: #111518">{{make}} {{model}} ({{registrationNumber}})</strong>.{{/body-text}}

  <tr>
    <td style="padding-bottom: 24px">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#EEF0F6" style="border-radius: 8px">
        <tr>
          <td style="padding: 16px 20px">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #666666; padding-bottom: 8px; width: 110px">Rodzaj serwisu</td>
                <td align="right" style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold; color: #111518; padding-bottom: 8px">{{serviceType}}</td>
              </tr>
              <tr>
                <td style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #666666; padding-bottom: 8px">Data</td>
                <td align="right" style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold; color: #111518; padding-bottom: 8px">{{serviceDate}}</td>
              </tr>
              <tr>
                <td style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #666666; padding-bottom: 8px">Koszt</td>
                <td align="right" style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold; color: #111518; padding-bottom: 8px">{{cost}} zł</td>
              </tr>
              <tr>
                <td style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #666666">Warsztat</td>
                <td align="right" style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold; color: #111518">{{provider}}</td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  {{> button label="Zobacz historię serwisową" buttonWidth="200" }}
{{/layout}}
