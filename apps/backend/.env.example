NODE_ENV=development

# Generate with: openssl rand -hex 32
COOKIE_KEY=replace-me-with-a-long-random-string

# Public URL of the frontend, used to build verification links
# Staging: your stable Netlify URL (e.g. https://staging--your-site.netlify.app)
FRONTEND_URL=http://localhost:5173

# Optional: comma-separated CORS origins (defaults to FRONTEND_URL)
# CORS_ORIGINS=https://staging--your-site.netlify.app,https://deploy-preview-1--your-site.netlify.app

# Optional: comma-separated regex patterns matched against the request Origin
# header to pick which frontend host appears in outbound mail links.
# FRONTEND_URL is always implicitly allowed; only add patterns for the extra
# hosts you want to accept (production + branch deploys + preview deploys).
# Example (Netlify):
# FRONTEND_URL_PATTERNS=^https:\/\/([\w-]+--)?your-site\.netlify\.app$

# PostgreSQL (Neon). Omit for local SQLite.
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# SQLite path when DATABASE_URL is not set (local dev only)
# DATABASE_PATH=db.sqlite

# Run migrations on startup (set true on Render staging)
# RUN_MIGRATIONS=true

# SMTP transport (Mailtrap for staging)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=replace-me
MAIL_PASS=replace-me
MAIL_FROM="GoFunIo <no-reply@gofun.io>"

# Verification token lifetime
VERIFICATION_TOKEN_TTL_HOURS=24
