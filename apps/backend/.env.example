NODE_ENV=development

# Generate with: openssl rand -hex 32
COOKIE_KEY=replace-me-with-a-long-random-string

# Public URL of the frontend, used to build verification links
FRONTEND_URL=http://localhost:5173

# SMTP transport (works for raw SMTP and SendGrid SMTP relay)
# For SendGrid: MAIL_HOST=smtp.sendgrid.net, MAIL_PORT=587, MAIL_USER=apikey, MAIL_PASS=<SG_API_KEY>
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=replace-me
MAIL_PASS=replace-me
MAIL_FROM="GoFunIo <no-reply@gofun.io>"

# Verification token lifetime
VERIFICATION_TOKEN_TTL_HOURS=24
