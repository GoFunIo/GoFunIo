{
  "name": "GoFunIo",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend start:dev",
    "dev": "concurrently --raw -n FRONTEND,BACKEND -c cyan,green \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "build": "pnpm --filter frontend build && pnpm --filter backend build",
    "migration:run": "pnpm --filter backend migration:run",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint:frontend": "pnpm --filter frontend run lint",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3",
      "esbuild",
      "@nestjs/core",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@types/node": "^25.4.0",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "latest",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0"
  }
}